  <Kpis>
    <Kpi dwd:design-time-name="5b485e93-2c14-497b-9d5a-826d6853482a">
      <ID>KPI</ID>
      <Name>Profit Performance</Name>
      <AssociatedMeasureGroupID>Fact Sales</AssociatedMeasureGroupID>
      <Value>[Measures].[Profit]</Value>
      <Goal>[Measures].[Sales Amount] * 0.2</Goal>
      <Status>CASE 
WHEN [Measures].[Profit] &gt;= [Measures].[Sales Amount] * 0.2 THEN 1
WHEN [Measures].[Profit] &gt;= [Measures].[Sales Amount] * 0.1 THEN 0
ELSE -1
END</Status>
      <Trend>([Measures].[Profit], [Time Dim].[Year].CurrentMember)
-
([Measures].[Profit], [Time Dim].[Year].PrevMember)</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
